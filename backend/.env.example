# =============================================================================
# Variables del backend — copiar como backend/.env y completar
# =============================================================================
# Spring lo lee solo, por la línea spring.config.import de
# application.properties. Las variables de entorno del sistema tienen
# prioridad: en un servidor se pueden definir ahí y no hace falta este archivo.
#
# backend/.env está en .gitignore. Nunca subirlo.
# =============================================================================

# Perfil de arranque:
#   dev  -> PostgreSQL local (por omisión)
#   prod -> base en la nube (Supabase)
SPRING_PROFILE=dev

# --- Base de datos -----------------------------------------------------------
# En el perfil dev, DB_URL y DB_USERNAME tienen valores por omisión
# (jdbc:postgresql://localhost:5432/muebleria_eden_db y postgres), así que
# alcanza con DB_PASSWORD. En prod las tres son obligatorias.
DB_URL=jdbc:postgresql://localhost:5432/muebleria_eden_db
DB_USERNAME=postgres
DB_PASSWORD=cambiar_por_la_contrasena_de_postgres

# --- Autenticación -----------------------------------------------------------
# Clave con la que se firman los tokens de sesión. Tiene que ser larga y
# aleatoria: quien la conozca puede fabricar tokens válidos de cualquier
# usuario, incluido el administrador. Mínimo 64 caracteres.
# Para generar una:  openssl rand -base64 64
JWT_SECRET=cambiar_por_una_clave_larga_y_aleatoria
