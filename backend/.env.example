# =============================================================================
# Variables del backend — copiar como backend/.env y completar
# =============================================================================
# Spring lo lee solo, por la línea spring.config.import de
# application.properties. Las variables de entorno del sistema tienen
# prioridad: en un servidor se pueden definir ahí y no hace falta este archivo.
#
# backend/.env está en .gitignore. Nunca subirlo.
# =============================================================================

# Perfil de arranque:
#   dev  -> PostgreSQL local (por omisión)
#   prod -> base en la nube (Supabase)
SPRING_PROFILE=dev

# --- Base de datos -----------------------------------------------------------
# En el perfil dev, DB_URL y DB_USERNAME tienen valores por omisión
# (jdbc:postgresql://localhost:5432/muebleria_eden_db y postgres), así que
# alcanza con DB_PASSWORD. En prod las tres son obligatorias.
DB_URL=jdbc:postgresql://localhost:5432/muebleria_eden_db
DB_USERNAME=postgres
DB_PASSWORD=cambiar_por_la_contrasena_de_postgres

# --- Autenticación -----------------------------------------------------------
# Clave con la que se firman los tokens de sesión. Tiene que ser larga y
# aleatoria: quien la conozca puede fabricar tokens válidos de cualquier
# usuario, incluido el administrador. Mínimo 64 caracteres.
# Para generar una:  openssl rand -base64 64
JWT_SECRET=cambiar_por_una_clave_larga_y_aleatoria

# --- Almacenamiento de archivos (Supabase Storage) ----------------------------
# Fotos de productos (bucket público "productos") y fotos de comprobantes de pago
# (bucket privado "comprobantes"). Las dos van juntas.
#   SUPABASE_URL          URL del proyecto: Project Settings -> API
#   SUPABASE_SERVICE_KEY  clave service_role: Project Settings -> API
# La clave de servicio da acceso total al proyecto: solo la usa el backend, nunca se
# manda al frontend ni a la app, y no se sube al repositorio.
# En dev, si se dejan vacías, los archivos se guardan en backend/uploads/. En prod son
# obligatorias: sin ellas el backend no arranca.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Administrador inicial ----------------------------------------------------
# Solo para una base nueva y vacía (creada con database/00_esquema.sql): sin usuarios nadie
# puede iniciar sesión. Al arrancar, si la tabla usuarios está VACÍA y las dos variables
# están definidas, el backend crea con ellas un administrador (la contraseña se guarda con
# BCrypt y nunca se escribe en el registro). Si falta alguna, o ya hay usuarios, no hace nada.
#   ADMIN_INICIAL_USUARIO  de 3 a 30 caracteres: letras, números, puntos y guiones bajos
#   ADMIN_INICIAL_CLAVE    de 6 caracteres o más
# Una vez que se entró y se creó lo demás desde la pantalla de Usuarios, conviene quitar
# la clave del entorno.
ADMIN_INICIAL_USUARIO=
ADMIN_INICIAL_CLAVE=
