# =============================================================================
# Variables de la app móvil — copiar como app/.env
# =============================================================================
# Se pasan al compilar:
#   flutter run --dart-define-from-file=.env
#
# Quedan dentro del APK y cualquiera puede extraerlas: nunca poner acá una
# clave o una contraseña.
#
# El proyecto base todavía no usa ninguna. API_URL es la que va a necesitar
# el cliente de la API cuando se traiga desde el proyecto anterior
# (String.fromEnvironment('API_URL')).
# =============================================================================

# Dirección del backend, vista desde el teléfono. Para el celular "localhost"
# es el propio celular, no la computadora. Tres formas de alcanzarlo:
#
#   Emulador de Android:          http://10.0.2.2:8080
#   Celular por cable USB,
#   con "adb reverse tcp:8080 tcp:8080":  http://localhost:8080
#   Celular en la misma WiFi:     http://<IP de la computadora>:8080
API_URL=http://10.0.2.2:8080
