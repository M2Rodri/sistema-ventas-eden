# =============================================================================
# Variables del frontend — copiar como frontend/.env.local
# =============================================================================
# Next.js lee .env.local automáticamente al arrancar. Está en .gitignore.
#
# Las que empiezan con NEXT_PUBLIC_ terminan dentro del JavaScript que se
# envía al navegador: cualquiera las puede leer. Nunca poner una clave o una
# contraseña en una de ellas.
# =============================================================================

# Dirección del backend.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

# Dirección del backend que usa el servidor de la web (rutas /api/auth y /api/proxy) para hablarle.
# Nunca llega al navegador. Tiene prioridad sobre NEXT_PUBLIC_BACKEND_URL; si no se define, se usa esa.
# En Vercel debe apuntar al backend desplegado (por ejemplo la dirección de Render).
BACKEND_URL_INTERNAL=http://localhost:8080

# Opcional. Carpeta donde se deja la compilación. Solo sirve para verificar
# una compilación de producción sin pisar la del servidor de desarrollo:
#   NEXT_DIST_DIR=.next-verificacion npx next build
# NEXT_DIST_DIR=.next-verificacion
