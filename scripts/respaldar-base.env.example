# Plantilla del archivo de credenciales del respaldo automático (scripts/respaldar-base.mjs).
#
# COPIAR a  ../credenciales-supabase.env  (una carpeta ARRIBA del proyecto, FUERA del repositorio)
# y completar. Ese archivo nunca se sube a GitHub. No pongas la clave de la base en ningún otro lado.
#
# Los datos de conexión están en Supabase: Project Settings > Database > Connection string
# (usar el "Session pooler", puerto 5432).

PGHOST=aws-0-us-east-1.pooler.supabase.com
PGUSER=postgres.xxxxxxxxxxxxxxxxxxxx
PGPASSWORD=la_contraseña_de_la_base

# Opcionales
# PGPORT=5432
# PGDATABASE=postgres
# PGSSLMODE=require

# Segunda carpeta donde dejar una copia de cada respaldo, por ejemplo un pendrive o OneDrive.
# Si falla (el pendrive no está), el respaldo igual queda hecho y se avisa en el registro.
# RESPALDO_COPIA=E:/copias-muebleria-eden
